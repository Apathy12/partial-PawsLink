# Copy to .env.local (Vite loads that file automatically).
# Create a free project at https://supabase.com then paste the values from
# Project Settings → API.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY

# Demo only: password-only access for cavd@demo.local after migration 0016.
# Set to false after restoring the database MFA rule.
# VITE_CAVD_DEMO_PASSWORD_ONLY=true

# Optional bot challenge for signup and login. Configure the matching secret
# in Supabase Auth before enabling CAPTCHA there.
# VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY

# Used only by `npm run seed`. Never prefix this with VITE_ — it must not
# ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Unique private passwords for the four optional demo accounts. Generate
# random values and keep this file out of version control.
DEMO_USER_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_PASSWORD
DEMO_ADOPTER_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_PASSWORD
DEMO_VET_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_PASSWORD
DEMO_CAVD_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_PASSWORD

# For controlled database migrations and complete backups only. Never prefix
# either variable with VITE_ or include it in Firebase Hosting settings.
# SUPABASE_DB_URL=YOUR_DATABASE_CONNECTION_STRING
# PAWSLINK_BACKUP_DIR=/absolute/path/on/an/encrypted/backup/drive
