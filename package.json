{
  "name": "pawslink",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/partial-PawsLink/ && node scripts/pages-404.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:onboarding": "node --experimental-strip-types scripts/test-onboarding.mjs",
    "test:ocr": "node --experimental-strip-types scripts/test-ocr.mjs",
    "test:rls": "node scripts/test-rls.mjs",
    "test:matching": "node --experimental-strip-types scripts/test-matching.mjs",
    "test:applications": "node --experimental-strip-types scripts/test-applications.mjs",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "seed:matching": "node --env-file=.env.local scripts/seed-matching.mjs",
    "backup": "node --env-file=.env.local scripts/backup.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@zxing/browser": "^0.2.1",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
